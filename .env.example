# Every variable the app reads. Real values live in .env (never committed) and
# in the Vercel project settings. Only the two NEXT_PUBLIC_ variables reach the
# browser; everything else stays on the server. None of these is needed to run
# the MCP server in memory mode (npm run mcp:inspect).

# --- Supabase Postgres -------------------------------------------------------
# The pooler URL from Supabase (Project settings > Database > Connection string,
# "Session pooler", port 5432). The app switches it to transaction mode (6543)
# itself; migrations keep session mode because their lock needs a session.
SUPABASE_DB_URL=

# --- Anthropic (the support agent) --------------------------------------------
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (the default, by decision on 2026-09-29) or claude-haiku-4-5-20251001.
AGENT_MODEL=claude-sonnet-5-5

# --- Our own endpoint secrets (32 random bytes each) ---------------------------
# Bearer token the agent presents to /api/mcp.
MCP_AGENT_TOKEN=
# Bearer token Vapi presents to /api/vapi/chat/completions (custom-llm credential).
VAPI_LLM_TOKEN=
# Bearer token Vapi presents to /api/vapi/events (server headers).
VAPI_SERVER_TOKEN=
# Bearer token pg_cron presents to /api/cron/outbox (also stored in Supabase Vault by npm run db:schedule-outbox).
CRON_SECRET=

# --- App URL -----------------------------------------------------------------
# Where this app is reachable: http://localhost:3000 locally, the production
# domain on Vercel. The agent reaches the MCP server at APP_BASE_URL/api/mcp.
APP_BASE_URL=http://localhost:3000

# --- Vapi ----------------------------------------------------------------------
# Server-side only: npm run vapi:sync uses it to create or update the assistant.
VAPI_PRIVATE_KEY=
# Browser: the web call. Restrict it in the Vapi dashboard (allowedOrigins,
# allowedAssistantIds), or anyone who copies it can spend the account balance.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Printed by npm run vapi:sync.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# --- Knowledge base -------------------------------------------------------------
# Embeddings (text-embedding-3-small) for npm run kb:ingest and every search.
OPENAI_API_KEY=

# --- Callbacks and the handoff email -------------------------------------------
CAL_API_KEY=
# Printed by npm run cal:setup ("RelayPay support callback", 30 minutes).
CAL_EVENT_TYPE_ID=
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "RelayPay Support <support@example.com>".
RESEND_FROM_EMAIL=
# The admin inbox or inboxes that receive every handoff and alert, comma-separated.
SUPPORT_INBOX_EMAIL=
# sandbox books nothing and emails no one (evals); live does both. Default live.
SIDE_EFFECTS_MODE=live

# --- The support console --------------------------------------------------------
# Both written by npm run console:password (the password itself goes to .console-password.txt).
CONSOLE_PASSWORD_HASH=
# Signs the console's session cookie, and keys the hashed visitor IPs that the
# console lockout and the page's typed-message limit count. Required for typing.
CONSOLE_SESSION_SECRET=

# --- The MCP server's stdio entry ------------------------------------------------
# memory (seeded from assets/, no accounts) or supabase. Memory is the default without SUPABASE_DB_URL.
MCP_BACKEND=
