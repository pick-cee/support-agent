yarn-error.log*
.pnpm-debug.log*

# the console password, written once by npm run console:password
.console-password.txt

# misc
.DS_Store
Thumbs.db
*.pem

# local scratch: Phase 0 raw payload dumps before redaction, eval run output
/tmp/
/.scratch/
/evals/out/
