{
  "name": "relaypay-support-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:check-grants": "tsx --conditions=react-server scripts/check-grants.ts",
    "db:schedule-outbox": "tsx --conditions=react-server scripts/schedule-outbox.ts",
    "kb:ingest": "tsx --conditions=react-server scripts/kb-ingest.ts",
    "kb:calibrate": "tsx --conditions=react-server scripts/kb-calibrate.ts",
    "mcp:stdio": "tsx --conditions=react-server scripts/mcp-stdio.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector npx tsx scripts/mcp-stdio-memory.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "evidence": "tsx --conditions=react-server scripts/evidence-table.ts",
    "console:password": "tsx scripts/console-password.ts",
    "cal:setup": "tsx --conditions=react-server scripts/cal-setup.ts",
    "vapi:sync": "tsx --conditions=react-server scripts/vapi-sync.ts",
    "phase0:probe": "tsx --conditions=react-server scripts/phase0-probe.ts",
    "phase0:report": "tsx --conditions=react-server scripts/phase0-report.ts",
    "phase0:simulate": "tsx scripts/phase0-simulate-call.ts",
    "phase5:check": "tsx --conditions=react-server scripts/phase5-live-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@vapi-ai/web": "^2.7.1",
    "chrono-node": "^2.10.1",
    "next": "^16.3.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vapi-ai/server-sdk": "^2.0.1",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
